<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.research-vault-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>-B</string>
    <string>/ABSOLUTE/PATH/TO/brain/tools/research-watch.py</string>
    <string>watch</string>
    <string>--write</string>
    <string>--due</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/brain</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key><string>Asia/Taipei</string>
    <key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
